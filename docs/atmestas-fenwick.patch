+// Dar neistrauktu fondo vietu sarasas atrankai.
+// take(k) grazina k-taja likusia vieta (skaiciuojant nuo 0) ir ja pasalina.
+// Rezultatas toks pat kaip std::vector<size_t>{0, 1, ..., n-1} su erase(begin() + k),
+// tik vienas traukimas kainuoja O(log n), o ne O(n). Viduje naudojamas Fenwick medis.
+class RemainingIndices
+{
+public:
+    explicit RemainingIndices(size_t count);
+
+    size_t size() const { return left; }
+    bool empty() const { return left == 0; }
+    size_t take(size_t position); // position < size()
+
+private:
+    std::vector<uint32_t> tree; // tree[i] - kiek likusiu vietu yra i-ojo mazgo ruoze (indeksai nuo 1)
+    size_t left;
+    size_t highest_step; // didziausias dvejeto laipsnis, nevirsijantis vietu skaiciaus
+};
