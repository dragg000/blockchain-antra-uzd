 #include <unordered_set>
 #include <utility>
 
+RemainingIndices::RemainingIndices(size_t count) : tree(count + 1, 0), left(count), highest_step(1)
+{
+    // Kai visos vietos dar likusios, mazgas i dengia tiek vietu, koks jo zemiausias bitas.
+    for (size_t i = 1; i <= count; i++)
+    {
+        tree[i] = static_cast<uint32_t>(i & (~i + 1));
+    }
+    while (highest_step * 2 <= count)
+    {
+        highest_step *= 2;
+    }
+}
+
+size_t RemainingIndices::take(size_t position)
+{
+    const size_t count = tree.size() - 1;
+
+    // Leidziamasi medziu zemyn ieskant paskutines vietos, iki kurios likusiu yra maziau nei reikia.
+    size_t index = 0;
+    size_t needed = position + 1;
+    for (size_t step = highest_step; step > 0; step /= 2)
+    {
+        const size_t next = index + step;
+        if (next <= count && tree[next] < needed)
+        {
+            index = next;
+            needed -= tree[next];
+        }
+    }
+
+    // `index` yra ieskoma vieta (skaiciuojant nuo 0). Ji pazymima kaip istraukta.
+    for (size_t i = index + 1; i <= count; i += i & (~i + 1))
+    {
+        tree[i]--;
+    }
+    left--;
+    return index;
+}
