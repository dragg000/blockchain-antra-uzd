+static void test_remaining_indices()
+{
+    std::cout << "Traukimas is fondo: tas pats rezultatas kaip salinant is vektoriaus\n";
+    std::mt19937_64 rng(42);
+    bool same_as_vector = true;
+    for (size_t count : {0, 1, 2, 3, 7, 8, 9, 100, 1000, 1023, 1024, 1025, 5000})
+    {
+        RemainingIndices fast(count);
+        std::vector<size_t> slow(count);
+        for (size_t i = 0; i < count; i++)
+        {
+            slow[i] = i;
+        }
+        same_as_vector = same_as_vector && fast.size() == count && fast.empty() == (count == 0);
+
+        while (!slow.empty())
+        {
+            // Atsitiktine vieta, taip pat kartais pirma ir paskutine.
+            size_t position = rng() % slow.size();
+            if (rng() % 10 == 0)
+                position = 0;
+            else if (rng() % 10 == 0)
+                position = slow.size() - 1;
+
+            const size_t expected = slow[position];
+            slow.erase(slow.begin() + position);
+            same_as_vector = same_as_vector && fast.take(position) == expected && fast.size() == slow.size();
+        }
+        same_as_vector = same_as_vector && fast.empty();
+    }
+    CHECK(same_as_vector);
+}
